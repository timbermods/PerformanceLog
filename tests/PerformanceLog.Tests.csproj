<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>PerformanceLog.Tests</AssemblyName>
    <RootNamespace>PerformanceLog.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Timberborn</GameDir>
    <Managed>$(GameDir)\Timberborn_Data\Managed</Managed>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\1062090\3284904751\0Harmony.dll</HarmonyPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\source\PerformanceLog.csproj" />
    <Reference Include="$(HarmonyPath)" />
    <!-- Only compiled against; the tests load them from the game folder when they run (see Program.cs). -->
    <Reference Include="$(Managed)\System.Collections.Immutable.dll" Private="false" />
    <Reference Include="$(Managed)\Timberborn.SingletonSystem.dll" Private="false" />
    <Reference Include="$(Managed)\Timberborn.TickSystem.dll" Private="false" />
    <Reference Include="$(Managed)\Timberborn.Metrics.dll" Private="false" />
    <Reference Include="$(Managed)\Timberborn.Multithreading.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
</Project>
